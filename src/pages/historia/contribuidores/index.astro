---
import Layout from "@/layouts/Layout.astro";
import Contributor from "@/components/Contributor";
const contributors = [
    {
        name: "Cristhian Tapiero",
        description:
            "Ingeniero de sistemas con experiencia en multiples campos, creador de MANEFACT.",
        img: "https://media.licdn.com/dms/image/v2/D4E03AQEm2fjbpmLqaQ/profile-displayphoto-shrink_400_400/profile-displayphoto-shrink_400_400/0/1686335674174?e=1736380800&v=beta&t=Jw8gUMUdBqc2WjUH-4lmQTWmjrvlR6s0O4BEk3JJQ04",
        role: "CEO",

        github: { url: "https://github.com", username: "CristhianTapiero" },
        linkedin: { url: "https://linkedin.com", username: "Cristhian Tapiero" },
    },
];

const crumbs = [
    { name: "Inicio", href: "/", actual: false },
    { name: "Historia", href: "/historia", actual: false },
    { name: "Contribuidores", href: "/historia/contribuidores", actual: true },
];
---

<Layout title="Contribuidores" crumbs={crumbs}>
    <section class="section py-4 flex flex-col">
        <h1>Contribuidores</h1>
        <p>
            En esta sección encontrarás a los contribuidores de nuestra empresa.
        </p>
        <div
            class="flex w-full flex-wrap flex-grow justify-center items-center gap-x-4 mt-5 gap-y-2"
        >
            {
                contributors.map((contributor) => (
                    <Contributor className="max-w-96 py-4 gap-y-2 border-2 border-contrast rounded-xl" {...contributor} />
                ))
            }
        </div>
    </section>
</Layout>
