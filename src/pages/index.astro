---
import '@/styles/globals.css'
import Layout from '@/layouts/Layout.astro'

const crumbs = [
  { name: 'Inicio', href: '/', actual: true }
]
---
<Layout title='Index' crumbs={crumbs}>
  <section class="section flex items-center justify-center flex-col">
    <h1 class="text-6xl font-semibold font-bruno">MANEFACT</h1>
    <div class="flex w-fit gap-x-2 mt-5">
      <a href="/productos" class="px-4 py-2 bg-contrast text-white rounded-md hover:bg-contrast/90">Productos</a>
      <a href="/historia" class="px-4 py-2 bg-contrast text-white rounded-md hover:bg-contrast/90">Historia</a>
      <a href="/sobre-nosotros" class="px-4 py-2 bg-contrast text-white rounded-md hover:bg-contrast/90">Sobre Nosotros</a>
    </div>
  </section>
</Layout>